# Clerk. Local + Preview (staging, PR previews) use the development instance (pk_test_/sk_test_);
# the Vercel Production scope carries the production instance's pk_live_/sk_live_.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Python backend (backend/), also set on Vercel. Neon `home-dash` project: Production scope
# points at the `main` branch, Preview at the `staging` branch. Locally use staging too.
DATABASE_URL=postgresql://...neon.tech/neondb?sslmode=require
# Public URL of the ledboard daemon on the Pi
LEDBOARD_URL=https://jasperpi.tail744a86.ts.net
# Origins allowed in the Clerk token's azp claim and in etch Origin/Referer, comma separated.
# Production is https://worm.beer; the Preview scope needs https://staging.worm.beer too.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
