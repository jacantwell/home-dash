# Clerk. Local + Preview (staging, PR previews) use the development instance (pk_test_/sk_test_);
# the Vercel Production scope carries the production instance's pk_live_/sk_live_.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Python backend (backend/), also set on Vercel. Neon `home-dash` project: Production scope
# points at the `main` branch, Preview at the `staging` branch. Locally use staging too.
DATABASE_URL=postgresql://...neon.tech/neondb?sslmode=require
# Public URL of the ledboard daemon on the Pi
LEDBOARD_URL=https://jasperpi.tail744a86.ts.net
# Origins allowed in the Clerk token's azp claim and in etch Origin/Referer, comma separated.
# Production is https://worm.beer; the Preview scope needs https://staging.worm.beer too.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# House calendar, backend only. Production points at the real House calendar, Preview and
# local at "House (test)" so previews don't land on the hallway board. The json is the
# home-dash-writer service account's key on one line; share each calendar with its client_email.
GOOGLE_CALENDAR_ID=...@group.calendar.google.com
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Gallery photo storage, backend only (infra/, personal AWS account). Preview/local use the
# staging bucket, Production the production one; `make output ENV=...` in infra/ prints the
# first four. The private key is the CloudFront signing key's PEM, base64 on one line.
PHOTOS_BUCKET=home-dash-photos-staging-992382417038
PHOTOS_REGION=eu-west-2
PHOTOS_CDN_URL=https://d285jf13ny6jrg.cloudfront.net
PHOTOS_CDN_KEY_PAIR_ID=K2ZXAKKBOJUI0V
PHOTOS_CDN_PRIVATE_KEY=
PHOTOS_AWS_ACCESS_KEY_ID=
PHOTOS_AWS_SECRET_ACCESS_KEY=
