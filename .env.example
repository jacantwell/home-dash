# Clerk. worm.beer still runs on the dev instance — swap in a production instance's
# pk_live_/sk_live_ on the Vercel Production scope to shed the dev-mode limits.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Python backend (backend/), also set on Vercel
DATABASE_URL=postgresql://...neon.tech/neondb?sslmode=require
# Public URL of the ledboard daemon on the Pi
LEDBOARD_URL=https://jasperpi.tail744a86.ts.net
# Origins allowed in the Clerk token's azp claim and in etch Origin/Referer, comma separated.
# Production is https://worm.beer; the Preview scope needs https://staging.worm.beer too.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
